# --------------------------------------------------------
# The Astro Healer — Production Apache Configuration (.htaccess)
# --------------------------------------------------------

# 1. Disable Directory Browsing
Options -Indexes

# 2. Set Default Index
DirectoryIndex index.php index.html

# 3. Rewrite Engine & SSL Redirection
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Force HTTPS on live domains (skips localhost for local development)
  RewriteCond %{HTTP_HOST} !^localhost(:[0-9]+)?$ [NC]
  RewriteCond %{HTTP_HOST} !^127\.0\.0\.1(:[0-9]+)?$ [NC]
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Redirect www to non-www for clean canonical domain (avoids duplicate content penalties)
  RewriteCond %{HTTP_HOST} ^www\.(theastrohealer\.com)$ [NC]
  RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

  # Pretty Blog URLs: /blog/slug-here -> blog-post.php?slug=slug-here
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^blog/([a-zA-Z0-9_-]+)/?$ blog-post.php?slug=$1 [L,QSA]

  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^blog/?$ blog.php [L,QSA]

  # Pretty Course URLs: /course/slug-here -> course.php?slug=slug-here
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^course/([a-zA-Z0-9_-]+)/?$ course.php?slug=$1 [L,QSA]
</IfModule>

# 4. Block Public Access to Sensitive Files & Configurations
<FilesMatch "^(\.env|\.env\..*|\.user\.ini|\.git.*|.*\.sql|composer\.(json|lock)|package(-lock)?\.json|tsconfig\.json|user_database\.json|.*\.log|.*\.bak|.*\.sh)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# 5. PHP Settings for Video Uploads (mod_php fallback; PHP-FPM relies on .user.ini)
<IfModule php_module>
  php_value upload_max_filesize 1024M
  php_value post_max_size 1024M
  php_value max_execution_time 1200
  php_value max_input_time 1200
  php_value memory_limit 512M
</IfModule>
<IfModule mod_php.c>
  php_value upload_max_filesize 1024M
  php_value post_max_size 1024M
  php_value max_execution_time 1200
  php_value max_input_time 1200
  php_value memory_limit 512M
</IfModule>
<IfModule mod_php7.c>
  php_value upload_max_filesize 1024M
  php_value post_max_size 1024M
  php_value max_execution_time 1200
  php_value max_input_time 1200
  php_value memory_limit 512M
</IfModule>
<IfModule mod_php8.c>
  php_value upload_max_filesize 1024M
  php_value post_max_size 1024M
  php_value max_execution_time 1200
  php_value max_input_time 1200
  php_value memory_limit 512M
</IfModule>


# 6. Gzip / Deflate Compression (Speed & Core Web Vitals)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/plain
  AddOutputFilterByType DEFLATE text/html
  AddOutputFilterByType DEFLATE text/xml
  AddOutputFilterByType DEFLATE text/css
  AddOutputFilterByType DEFLATE text/javascript
  AddOutputFilterByType DEFLATE application/xml
  AddOutputFilterByType DEFLATE application/xhtml+xml
  AddOutputFilterByType DEFLATE application/rss+xml
  AddOutputFilterByType DEFLATE application/javascript
  AddOutputFilterByType DEFLATE application/x-javascript
  AddOutputFilterByType DEFLATE application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# 7. Browser Caching Headers (mod_expires)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType application/pdf "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>


# 8. HTTP Security & SEO Trust Headers
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-XSS-Protection "1; mode=block"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
